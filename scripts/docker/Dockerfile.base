ARG CUDA_BASE_IMAGE
FROM ${CUDA_BASE_IMAGE} AS base

ARG USERNAME=jaxpp-dev
ARG USER_UID=1001
ARG USER_GID=$USER_UID
# set by docker buildx, e.g., linux/amd64 or linux/arm64
ARG TARGETARCH

# Necessary to build documentation and avoid locale error
ENV LC_ALL=C

ENV USER_UID=${USER_UID}
ENV USER_GID=${USER_UID}

RUN echo ${CUDA_BASE_IMAGE}

# Preserve any networking libraries and loader setup supplied by the parent.
# Keep NCCL and cuDNN exclusively in the venv to avoid loading two versions.
RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        sudo locales nvtop wget git openssh-client build-essential vim zip unzip \
    && rm -rf /var/lib/apt/lists/*

# Create the user
RUN groupadd --gid $USER_GID $USERNAME \
    && useradd --uid $USER_UID --gid $USER_GID -m --shell /bin/bash $USERNAME \
    # Add sudo support.
    && echo $USERNAME ALL=\(root\) NOPASSWD:ALL > /etc/sudoers.d/$USERNAME \
    && chmod 0440 /etc/sudoers.d/$USERNAME

WORKDIR /workdir
RUN chown -R $USER_UID:$USER_GID /workdir

USER $USERNAME
SHELL ["/bin/bash", "--login", "-c"]

COPY --chown=$USER_UID:$USER_GID . jaxpp

ENV VIRTUAL_ENV=/home/$USERNAME/dev-env
ENV UV_PROJECT_ENVIRONMENT=$VIRTUAL_ENV
ENV PATH=$VIRTUAL_ENV/bin:$VIRTUAL_ENV/lib/python3.12/site-packages/nvidia/cu13/bin:/home/$USERNAME/.local/bin:$PATH

# TE must use the locked wheel headers instead of the base's partial toolkit.
# setup-env.sh creates libnccl.so so the extension's -lnccl resolves here too.
ENV NVTE_BUILD_USE_NVIDIA_WHEELS=1
ENV CPATH=$VIRTUAL_ENV/lib/python3.12/site-packages/nvidia/cu13/include:$VIRTUAL_ENV/lib/python3.12/site-packages/nvidia/cudnn/include:$VIRTUAL_ENV/lib/python3.12/site-packages/nvidia/nccl/include
ENV LIBRARY_PATH=$VIRTUAL_ENV/lib/python3.12/site-packages/nvidia/nccl/lib

RUN bash jaxpp/scripts/setup-env.sh

# Register the venv's NCCL and cuDNN lib dirs with ldconfig so libnccl.so.2
# and libcudnn.so.9 resolve unambiguously at import time, independent of
# LD_LIBRARY_PATH (enroot/pyxis often strips it).
USER root
RUN printf '%s\n'                                                               \
        "$VIRTUAL_ENV/lib/python3.12/site-packages/nvidia/nccl/lib"             \
        "$VIRTUAL_ENV/lib/python3.12/site-packages/nvidia/cudnn/lib"            \
        > /etc/ld.so.conf.d/jaxpp-venv.conf                                     \
    && ldconfig
USER $USERNAME

# Check TE's runtime libraries on builders without GPUs as well.
RUN JAX_PLATFORMS=cpu python -c 'from transformer_engine.jax.sharding import global_shard_guard, MeshResource'


ENTRYPOINT ["/bin/bash", "--login", "-c"]
CMD ["bash"]
